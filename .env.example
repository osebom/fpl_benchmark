# Cohere (required for the LLM manager)
COHERE_API_KEY=

# Supabase (required to persist the simulated manager timeline)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Databricks-hosted MLflow (Experiments → your experiment → kebab → Log traces locally → Generate API Key)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
MLFLOW_TRACKING_URI=
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT_ID=
# Optional if you prefer a workspace path instead of an ID
# MLFLOW_EXPERIMENT_NAME=/Shared/fpl_sim

# Optional. Defaults to <repo>/final_fpl
FPL_DATA_DIR=
